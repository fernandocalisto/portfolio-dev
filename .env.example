# Google AI Studio - Gemini API Key
# Obtenha sua chave gratuitamente em: https://aistudio.google.com/app/apikey
# IMPORTANTE: Nunca compartilhe nem commite seu arquivo .env com sua chave real.
GEMINI_API_KEY=
# Telegram Bot para formulário de contato
# Crie seu bot em https://t.me/BotFather e obtenha o token
TELEGRAM_BOT_TOKEN=
# Seu User ID do Telegram (obtenha em https://t.me/userinfobot)
TELEGRAM_CHAT_ID=
