# OpenRouter API Key — modelos gratuitos para o chatbot Dobby
# Obtenha sua chave em: https://openrouter.ai/keys
# Modelos gratuitos disponiveis: llama-3.2-3b, gemini-2.0-flash, qwen-2.5-7b
OPENROUTER_API_KEY=
# Telegram Bot para formulário de contato
# Crie seu bot em https://t.me/BotFather e obtenha o token
TELEGRAM_BOT_TOKEN=
# Seu User ID do Telegram (obtenha em https://t.me/userinfobot)
TELEGRAM_CHAT_ID=
